<ui:FluentWindow
    x:Class="AutoMouseMover.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Auto Mouse Mover"
    Width="380"
    SizeToContent="Height"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    StateChanged="Window_StateChanged"
    Closing="Window_Closing">

    <StackPanel>
        <!-- Title bar: no maximize, language menu on the right -->
        <ui:TitleBar Title="Auto Mouse Mover" ShowMaximize="False">
            <ui:TitleBar.TrailingContent>
                <ui:Button
                    x:Name="LanguageButton"
                    Padding="8,4"
                    Appearance="Transparent"
                    BorderThickness="0"
                    Click="LanguageButton_Click"
                    Icon="{ui:SymbolIcon LocalLanguage24}" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <StackPanel Margin="16,4,16,16">
            <!-- Status card -->
            <Border x:Name="StatusCard" Padding="16" CornerRadius="8">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Margin="0,0,0,6" />
                    <TextBlock x:Name="StatusText" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusDetail" HorizontalAlignment="Center" Opacity="0.8" />
                </StackPanel>
            </Border>

            <ui:Button
                x:Name="PauseResumeButton"
                Margin="0,12,0,0"
                HorizontalAlignment="Stretch"
                Appearance="Primary"
                Click="PauseResumeButton_Click" />

            <!-- Schedule -->
            <TextBlock x:Name="ScheduleHeader" Margin="0,20,0,6" FontWeight="SemiBold" />
            <ui:Card>
                <StackPanel>
                    <ui:ToggleSwitch x:Name="ScheduleToggle" Click="ScheduleToggle_Click" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WorkHoursLabel" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="StartTimeBox" Width="72" LostFocus="TimeBox_LostFocus" KeyDown="TimeBox_KeyDown" />
                            <TextBlock Margin="6,0" VerticalAlignment="Center" Text="–" />
                            <TextBox x:Name="EndTimeBox" Width="72" LostFocus="TimeBox_LostFocus" KeyDown="TimeBox_KeyDown" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="WorkDaysLabel" Margin="0,12,0,6" />
                    <!-- Seven day toggles, Monday first, filled in code -->
                    <UniformGrid x:Name="DaysPanel" Columns="7" />

                    <TextBlock
                        x:Name="ScheduleError"
                        Margin="0,8,0,0"
                        Foreground="#D13438"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <ui:ToggleSwitch x:Name="StartWithWindowsToggle" Margin="0,12,0,0" Click="StartWithWindowsToggle_Click" />
                </StackPanel>
            </ui:Card>

            <!-- Movement -->
            <TextBlock x:Name="MovementHeader" Margin="0,20,0,6" FontWeight="SemiBold" />
            <ui:Card>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="IntervalLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ui:NumberBox
                            x:Name="IntervalBox"
                            Grid.Column="1"
                            Width="120"
                            MaxDecimalPlaces="0"
                            Maximum="30"
                            Minimum="2"
                            SmallChange="1"
                            ValueChanged="IntervalBox_ValueChanged" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PixelLabel" VerticalAlignment="Center" />
                        <ui:NumberBox
                            x:Name="PixelBox"
                            Grid.Column="1"
                            Width="120"
                            MaxDecimalPlaces="0"
                            Maximum="200"
                            Minimum="1"
                            SmallChange="1"
                            ValueChanged="PixelBox_ValueChanged" />
                    </Grid>
                    <ui:ToggleSwitch x:Name="ClickToggle" Margin="0,12,0,0" Click="ClickToggle_Click" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
